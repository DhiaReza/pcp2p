@{
    ViewData["Title"] = "Hardware Catalogue";
}
@model IEnumerable<Hardware>;
    
<!DOCTYPE html>
<html>
<head>
    <script src="~\pcp2p\wwwroot\lib\bootstrap\dist\js\bootstrap.bundle.js"></script>
</head>
<body>
  <div class="container">
    <div class="">
      <div class="pt-2">
        Sort By:
      </div>
      <div class="row">
        <div class="col">
          <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
              @if (!String.IsNullOrEmpty(ViewBag.CurrentSort))
              {
                  switch (ViewBag.CurrentSort)
                  {
                      case "name_asc":
                          @:Name A-Z
                          break;
                      case "name_desc":
                          @:Name Z-A
                          break;
                      case "newest":
                          @:Newest First
                          break;
                      case "oldest":
                          @:Oldest First
                          break;
                      case "expensive":
                          @:Expensive First
                          break;
                      case "cheapest":
                          @:Cheap First
                          break;
                  }
              }
              else
              {
                  @:Newest First
              }
            </button>
            <ul class="dropdown-menu text-center " aria-labelledby="dropdownMenuButton1">
              <li class="py-1">
                <a class = "text-black text-decoration-none" asp-controller="Catalogue" asp-action="Index" asp-route-searchString="@ViewBag.CurrentSearchString" asp-route-sortOrder="name_asc">
                  Name A-Z
                  </a>
                </li>
              <li class="py-1">
                <a class = "text-black text-decoration-none" asp-controller="Catalogue" asp-action="Index" asp-route-searchString="@ViewBag.CurrentSearchString" asp-route-sortOrder="name_desc">
                  Name Z-A
                </a>
                </li>
              <li class="py-1">
                <a class = "text-black text-decoration-none" asp-controller="Catalogue" asp-action="Index" asp-route-searchString="@ViewBag.CurrentSearchString" asp-route-sortOrder="newest">
                  Newest First
                </a>
              </li>
              <li class="py-1">
                <a class = "text-black text-decoration-none" asp-controller="Catalogue" asp-action="Index" asp-route-searchString="@ViewBag.CurrentSearchString" asp-route-sortOrder="oldest">
                  Oldest First
                </a>
              </li>
              <li class="py-1">
                <a class = "text-black text-decoration-none" asp-controller="Catalogue" asp-action="Index" asp-route-searchString="@ViewBag.CurrentSearchString" asp-route-sortOrder="expensive">
                  Expensive First
                </a>
              </li>
              <li class="py-1">
                <a class = "text-black text-decoration-none" asp-controller="Catalogue" asp-action="Index" asp-route-searchString="@ViewBag.CurrentSearchString" asp-route-sortOrder="cheap">
                  Cheap First
                </a>
              </li>
            </ul>
        </div>
        </div>
        <div class="col">
          <form asp-controller="Catalogue" asp-action="Index" asp-route-sortOrder="@ViewBag.currentSort" asp-route-currentPage="@ViewBag.CurrentPage">
              <div class="input-group mb-3">
                  <span class="input-group-text" id="basic-addon1">
                      <img src="~/img/bootstrap_icons/search.svg" alt="Search Icon" width="16" height="16" />
                  </span>
                  <input type="text" class="form-control" placeholder="Search..." value="@ViewBag.CurrentSearchString" name="searchString">
                  <input type="hidden" name="currentPage" value="1" />
                  <button type="submit" class="btn btn-primary">Search</button>
              </div>
          </form>
        </div>
      </div>
    <div class="pt-2 vh-50">
        <table class="table table-sm table-hover table-light text-center shadow-sm mb-4 rounded bg-white" style="background-color: #FFFFFF; border-radius: 1rem;">
            <thead>
                <tr class="align-middle">
                    <th>#</th>
                    <th>CPU Name</th>
                    <th>Date Released</th>
                    <th>MSRP</th>
                    <th>Spesification</th>
                    <th>Benchmark Availability</th>
                    <th>_</th>              
                </tr>
            </thead>
            <tbody class="align-middle">
                @{int numrow = 1;}
                @foreach(var hw in Model){
                    <tr class="align-middle">
                        <th scope="row">@numrow</th>
                        <td>@hw.Name</td>
                        <td>@hw.ReleaseDate.ToString("MMMM yyyy")</td>
                        <td>$@hw.MSRP</td>
                        <td>
                            @{
                                if(hw.Cpu != null){
                                    <ul class="list-unstyled small lh-1 mb-0">
                                        <li class="">@hw.Cpu.CoreCount Cores / @hw.Cpu.ThreadCount Threads</li>
                                        <li class="">@hw.Cpu.BaseClock GHz Base / @hw.Cpu.TurboClock GHz Turbo</li>
                                        @{
                                            if(hw.Brand.Name == "intel"){
                                                <li class="">LGA @hw.Cpu.Socket</li>
                                            }
                                            else{
                                                <li class="">@hw.Cpu.Socket</li>
                                            }
                                        }
                                    </ul>
                                } else {
                                    <ul class="list-unstyled small lh-1 mb-0">
                                        <li class="">@hw.Gpu.Vram GB</li>
                                        <li class="">@hw.Gpu.BaseClock MHz Base Clock</li>          
                                        <li class="">@hw.Gpu.BoostClock MHz Boost Clock</li>    
                                    </ul>
                                }
                            }
                        </td>
                        <td>
                            <div class="accordion accordion-flush mx-auto d-flex justify-content-center" id="accordion-@hw.Id">
                                <div class="accordion-item border rounded shadow-sm mb-2">
                                    <h2 class="accordion-header" id="heading-@hw.Id">
                                        <button class="accordion-button collapsed text-dark fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@hw.Id" aria-expanded="false" aria-controls="collapse-@hw.Id">
                                            Available Benchmarks (@hw.Benchmarks.Count)
                                        </button>
                                    </h2>
                                    <div id="collapse-@hw.Id" class="accordion-collapse collapse" aria-labelledby="heading-@hw.Id" data-bs-parent="#accordion-@hw.Id">
                                        <div class="accordion-body bg-light rounded p-3 text-dark">
                                            <ul class="list-unstyled text-capitalize mb-0">
                                                @foreach(Benchmark bench in hw.Benchmarks){
                                                    <li class="fs-6">@bench.Date @bench.TestSubject.Name @bench.TestResolution.Name</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                          <div class="d-flex justify-content-center">
                            <button class="btn btn-outline-primary px-3 py-2 text-dark fw-semibold">Details</button>  
                          </div>
                        </td>
                    </tr>
                    numrow++;
                }
            </tbody>
        </table>
    </div>
    <div>
      <nav aria-label="Page navigation example">
        <ul class="pagination">
            @{
                int page = 1;
                while (page <= ViewBag.maxPage) {
                    <li class="page-item">
                        <a asp-controller="Catalogue" 
                        asp-action="Index" 
                        asp-route-currentPage="@(page)" 
                        asp-route-searchString="@ViewBag.CurrentSearchString"
                        asp-route-sortOrder="@ViewBag.currentSort"
                        class="page-link">@(page)</a>
                    </li>
                    page++;
                }
            }
        </ul>
      </nav>
    </div>
  </div>
</body>
</html>