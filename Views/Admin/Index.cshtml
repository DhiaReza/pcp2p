@{
    ViewData["Title"] = "PCP2P Admin Page";
}
@model pcp2p.Models.AdminPageDTO
<!DOCTYPE html>
<html>
<head>
    <script src="~\pcp2p\wwwroot\lib\bootstrap\dist\js\bootstrap.bundle.js"></script>
</head>
<body>
    <div class="container">
        <div class="col">
            <div class="row">
                <table class="table">
                    <thead>
                        <tr>
                        <th scope="col">#</th>
                        <th scope="col">Name</th>
                        <th scope="col">Brand</th>
                        <th scope="col">MSRP</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{foreach (var cpu in Model.Cpus){
                       <tr>
                        <th scope="row">1</th>
                        <td>@cpu.Name</td>
                        <td>@cpu.Brand.Name</td>
                        <td>@cpu.MSRP</td>
                        </tr>
                    }}
                    </tbody>
                </table>
            </div>
            <div class="row">
                <table class="table">
                    <thead>
                        <tr>
                        <th scope="col">#</th>
                        <th scope="col">First</th>
                        <th scope="col">Last</th>
                        <th scope="col">Handle</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                        <th scope="row">1</th>
                        <td>Mark</td>
                        <td>Otto</td>
                        <td>mdo</td>
                        </tr>
                        <tr>
                        <th scope="row">2</th>
                        <td>Jacob</td>
                        <td>Thornton</td>
                        <td>fat</td>
                        </tr>
                        <tr>
                        <th scope="row">3</th>
                        <td>John</td>
                        <td>Doe</td>
                        <td>social</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>