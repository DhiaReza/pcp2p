@{
    ViewData["Title"] = "Choose GPU";
}
@model SelectHardwareDTO;

<!DOCTYPE html>
<html>
<head>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</head>
<body>
    <div class="container">
        <div class="col">
            <form asp-controller="Compare" asp-action="HardwareComparison" method="get">
                <input type="hidden" name="hwtypeid" value="@Model.hwtypeid" />
                <!-- Hardware row -->
                <div class="row">
                    <!-- Select Hardware col -->
                    <div class="col-8">
                        <div class="card mt-3">
                            <div class="card-header bg-primary text-white">
                                <h5>Select Hardware</h5>
                            </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Search Bar -->
                            <div class="">
                                <input type="text"
                                    id="hardwareSearch"
                                    class="form-control mb-3"
                                    placeholder="Search hardware...">
                            </div>
                        </div>
                        <div class="text-danger align-middle py-3">
                            <span asp-validation-for="hardwares" class="text-danger align-middle"></span>
                        </div>
                            <div class="row row-cols-1 row-cols-sm-1 row-cols-lg-3 g-3 " 
                                style="max-height: 800px; overflow-y: auto; overflow-x: hidden;">
                                @foreach (var hardware in Model.hardwares)
                                {
                                    <div class="col hardware-item" data-name="@($"{hardware.Name} {hardware.Generation} {hardware.MSRP} {hardware.Vram}".ToLower())">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body p-3">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" 
                                                        name="hardwareids" value="@hardware.Id" 
                                                        id="hardware_@hardware.Id">
                                                    <label class="form-check-label" for="hardware_@hardware.Id">
                                                        <h6 class="card-title mb-0">@hardware.Name</h6>
                                                        <small class="text-muted mb-0 small">
                                                            @hardware.Generation | @hardware.Vram GB | $@(hardware.MSRP.ToString().Replace(".00",""))
                                                        </small>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                </div>   
                            </div>
                        </div>

                    </div>
                    
                    <div class="col-4 align-middle">
                        <!-- Select Preset -->
                        <div class="card mt-3">
                            <div class="card-header bg-primary text-white ">
                                <h5>Select Preset</h5>
                            </div>
                            <div class="card-body">
                                <select class="form-select" name="presetid">
                                    <option value="empty">Select a preset...</option>
                                    @foreach (TestPreset preset in Model.testPresets)
                                    {
                                        <option value="@preset.Id">@preset.Name</option>
                                    }
                                </select> 
                                <div class="text-danger align-middle pt-3">
                                    <span asp-validation-for="testPresets" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Select Subject -->
                        <div class="card mt-3">
                            <div class="card-header bg-primary text-white">
                                <h5>Select Category</h5>
                            </div>
                            <div class="card-body">
                                <select class="form-select" name="subjectid">
                                    <option value="empty">Select a Category...</option>
                                    <option class="text-capitalize" value="@Model.testSubjects[0].Id">Rasterization</option>
                                    <option class="text-capitalize" value="@Model.testSubjects[1].Id">Ray Tracing</option>
                                </select>
                                <div class="text-danger align-middle pt-3">
                                    <span asp-validation-for="testSubjects" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <!-- Submit button row -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100">Compare Hardware</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</body>
</html>

<script>
    const searchInput = document.getElementById("hardwareSearch");

    searchInput.addEventListener("keyup", function () {

        const searchValue = this.value.toLowerCase();

        const items = document.querySelectorAll(".hardware-item");

        items.forEach(item => {

            const hardwareName = item.dataset.name;

            if (hardwareName.includes(searchValue)) {
                item.style.display = "";
            } else {
                item.style.display = "none";
            }
        });
    });
</script>